<view class="review-root">
  <view class="review-topbar">
    <view class="topbar-side topbar-left" bindtap="onBack">
      <van-icon name="arrow-left" size="22px" color="#FFFFFF" />
      <text class="back-text">返回</text>
    </view>
    <view class="topbar-title">待审核</view>
    <view class="topbar-side"></view>
  </view>

  <view class="review-list">
    <view wx:if="{{loading}}" class="review-empty">加载中...</view>
    <view wx:elif="{{!reviewers.length}}" class="review-empty">暂无待审核报名</view>

    <block wx:else>
      <mf-template
        wx:for="{{reviewers}}"
        wx:key="registrationId"
        rows="1"
        density="md"
        align="left"
        bg="rgb(46,46,46)"
      >
        <view slot="left">
          <image class="avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
        </view>

        <view class="mid">
          <view class="t1">{{item.nickname}}</view>
          <view class="activity-title">{{item.activityTitle}}</view>
          <view class="score-row">
            <text>综合 {{item.overallRating}}/5</text>
            <text>时效 {{item.timelinessRating}}/5</text>
          </view>
        </view>

        <view slot="right" class="review-actions">
          <button
            class="review-action review-action--reject"
            data-id="{{item.registrationId}}"
            disabled="{{actingId}}"
            bindtap="onReject"
          >拒绝</button>
          <button
            class="review-action review-action--approve"
            data-id="{{item.registrationId}}"
            disabled="{{actingId}}"
            bindtap="onApprove"
          >通过</button>
        </view>
      </mf-template>
    </block>
  </view>
</view>
